pipeline {
  agent any

  options {
    timestamps()
    skipDefaultCheckout(true)
    disableResume()
    buildDiscarder(logRotator(numToKeepStr: '5'))
  }

  environment {
    FLUTTER_BIN = '/opt/flutter/bin/flutter'
    DART_BIN = '/opt/flutter/bin/dart'
    APP_USER = 'www-data'
    APP_GROUP = 'www-data'

    WEBAPP_TARGET_DIR = '/var/www/devapp.problemka-mtuci.tech/current'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Validate Flutter') {
      steps {
        sh '''
          set -eux
          "${FLUTTER_BIN}" config --no-analytics
          "${FLUTTER_BIN}" --version
          "${DART_BIN}" --version
          "${FLUTTER_BIN}" config --enable-web
          "${FLUTTER_BIN}" precache --web
        '''
      }
    }

    stage('Install dependencies') {
      steps {
        sh '''
          set -eux
          "${DART_BIN}" pub get
        '''
      }
    }

    stage('Build client app') {
      options {
        timeout(time: 40, unit: 'MINUTES')
      }
      steps {
        withCredentials([file(credentialsId: 'flutter-env-client', variable: 'FLUTTER_ENV_FILE')]) {
          dir('apps/client_app') {
            sh '''
              set -eux
              "${FLUTTER_BIN}" build web \
                --release \
                --no-pub \
                --no-tree-shake-icons \
                --dart-define-from-file="${FLUTTER_ENV_FILE}" \
                --output="${WORKSPACE}/build/client_app"
            '''
          }
        }
      }
    }

    stage('Deploy to server') {
      steps {
        sh '''
          set -eux

          ./scripts/deploy_flutter_web_local.sh \
            --source "build/client_app" \
            --target "${WEBAPP_TARGET_DIR}" \
            --owner "${APP_USER}:${APP_GROUP}"

          sudo nginx -t
          sudo systemctl reload nginx
        '''
      }
    }
  }

}
