{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "client",
      "request": "launch",
      "type": "dart",
      "program": "apps/client_app/lib/main.dart",
      "args": ["--dart-define-from-file", ".config.dev.json"]
    },
    {
      "name": "admin",
      "request": "launch",
      "type": "dart",
      "program": "apps/admin_panel/lib/main.dart",
      "args": ["--dart-define-from-file", "flutter-env-admin.json", "--web-browser-flag", "--disable-web-security", "--dart-define=SKIP_AUTH=true"]
    },
  ]
}
